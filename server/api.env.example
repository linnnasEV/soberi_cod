# Переменные сервера. Образец: настоящие значения живут в /etc/soberikod/api.env
# с правами 600 и в репозиторий не попадают — репозиторий открытый.
#
# Скопировать на сервере:
#   sudo install -d -m 755 /etc/soberikod
#   sudo install -m 600 /dev/null /etc/soberikod/api.env
#   sudo nano /etc/soberikod/api.env

# ===== База =====
# Пароль придумывается при создании роли в PostgreSQL.
SOBERIKOD_DATABASE_URL=postgresql+psycopg://soberikod:ПАРОЛЬ@localhost:5432/soberikod

# ===== Сайт =====
# Адрес, по которому собираются ссылки в письмах. Домен в ASCII-виде:
# соберикод.рф — это xn--90agcmkuenf.xn--p1ai, кириллицу здесь писать нельзя.
SOBERIKOD_SITE_ORIGIN=https://xn--90agcmkuenf.xn--p1ai

# Домены, которым разрешено обращаться к API из браузера. Пусто — сайт и API
# на одном домене, и разрешение не нужно вообще: так и задумано.
# Заполняется только на время локальной проверки, например http://localhost:8080
SOBERIKOD_CORS_ORIGINS=

# ===== Сессии =====
# Без HTTPS cookie с этим флагом браузер не отдаст. На сервере всегда true,
# false — только для проверки на своём компьютере.
SOBERIKOD_COOKIE_SECURE=true

# ===== Почта =====
# Бесплатный ящик Яндекса и пароль приложения из настроек Яндекс ID
# (раздел «Безопасность» → «Пароли приложений», тип «Почта»).
# Обычный пароль от аккаунта здесь не работает.
SOBERIKOD_SMTP_HOST=smtp.yandex.ru
SOBERIKOD_SMTP_PORT=465
SOBERIKOD_SMTP_USER=ящик@yandex.ru
SOBERIKOD_SMTP_PASSWORD=пароль-приложения
SOBERIKOD_SMTP_FROM=ящик@yandex.ru
SOBERIKOD_SMTP_FROM_NAME=СобериКод
